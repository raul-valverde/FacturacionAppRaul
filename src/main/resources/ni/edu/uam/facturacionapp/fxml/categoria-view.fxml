<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.facturacionapp.controller.CategoriaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Gestión de Categorías" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="80.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" promptText="Nombre de la categoría" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Estado:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <CheckBox fx:id="chkActivo" text="Activo" selected="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Guardar" onAction="#guardar" style="-fx-background-color: #2ec4b6; -fx-text-fill: white;"/>
        <Button text="Actualizar" onAction="#actualizar" style="-fx-background-color: #ff9f1c; -fx-text-fill: white;"/>
        <Button text="Eliminar" onAction="#eliminar" style="-fx-background-color: #e71d36; -fx-text-fill: white;"/>
        <Button text="Limpiar" onAction="#limpiar"/>
    </HBox>

    <TableView fx:id="tblCategorias" VBox.vgrow="ALWAYS" prefHeight="250.0">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60.0"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200.0"/>
            <TableColumn fx:id="colActivo" text="Activo" prefWidth="80.0"/>
        </columns>
    </TableView>
</VBox>