<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.facturacionapp.controller.ProductoController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <center>
        <VBox spacing="15">
            <!-- SECCIÓN DE BÚSQUEDA Y FILTROS -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Buscar:"/>
                <TextField fx:id="txtBuscar" promptText="Buscar por código, nombre o categoría..." HBox.hgrow="ALWAYS"/>
                <Label text="Estado:"/>
                <ComboBox fx:id="cmbFiltroEstado" prefWidth="120"/>
                <Label text="Categoría:"/>
                <ComboBox fx:id="cmbFiltroCategoria" prefWidth="150"/>
            </HBox>

            <Separator/>

            <!-- FORMULARIO DE REGISTRO -->
            <GridPane hgap="10" vgap="10">
                <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <ImageView fx:id="imgProducto" fitHeight="120" fitWidth="120" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.rowSpan="4"/>

                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <ComboBox fx:id="cbCategoria" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Existencia:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="txtExistencia" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Button fx:id="btnImagen" onAction="#seleccionarImagen" text="Buscar Imagen" GridPane.columnIndex="2" GridPane.rowIndex="4"/>

                <CheckBox fx:id="chkActivo" text="Estado Activo" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            </GridPane>

            <!-- TABLA DE PRODUCTOS -->
            <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="100"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="120"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100"/>
                    <TableColumn fx:id="colExistencia" text="Existencia" prefWidth="90"/>
                    <TableColumn fx:id="colActivo" text="Estado" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <BorderPane.margin>
                <Insets top="10"/>
            </BorderPane.margin>
            <Button fx:id="btnGuardar" onAction="#guardarProducto" text="Guardar"/>
            <Button fx:id="btnActualizar" onAction="#actualizar" text="Actualizar"/>
            <Button fx:id="btnEliminar" onAction="#eliminar" text="Eliminar"/>
            <Button fx:id="btnLimpiar" onAction="#limpiarFormulario" text="Limpiar"/>
            <Button fx:id="btnCerrar" onAction="#cerrar" text="Cerrar"/>
        </HBox>
    </bottom>
</BorderPane>